# Copy this file to `.env` and fill in the keys you have.
# `.env` is gitignored — keys never get committed.
#
# Each provider key is independent. You can fill only the ones you'll use.

# Makefile provider names:
#   VLM_PROVIDER=gemini | openai | grok | claude | github

# ----- OpenAI (VLM_PROVIDER=openai) -----
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: set if you want to use Azure OpenAI or another OpenAI-compatible
# endpoint instead of direct OpenAI.
OPENAI_BASE_URL=

# ----- GitHub Models (VLM_PROVIDER=github) -----
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com

# ----- Anthropic Claude (VLM_PROVIDER=claude) -----
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ----- Google Gemini (VLM_PROVIDER=gemini) -----
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Some Google libs read GEMINI_API_KEY as a fallback — set both to be safe.
GEMINI_API_KEY=

# ----- xAI Grok (VLM_PROVIDER=grok) -----
# Get a key: https://console.x.ai/team/default/api-keys
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# ----- CityWide raw asset/image download -----
CITYWIDE_API_KEY=
CITYWIDE_DB=
CITYWIDE_USER=
CITYWIDE_API_URL=https://v4.citywidesolutions.com/v4_server/external/v1

# ----- DagsHub MLflow (optional experiment logging) -----
# Get a token: https://dagshub.com/user/settings/tokens
# Already set in your ~/.zshrc; duplicated here so teammates can paste it.
DAGSHUB_USER_TOKEN=
