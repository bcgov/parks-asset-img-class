# Copy this file to `.env` and fill in the keys you have.
# `.env` is gitignored — keys never get committed.
#
# Each provider key is independent. You can fill only the ones you'll use.

# ----- OpenAI (gpt-5, gpt-5-mini, gpt-4.1, gpt-4.1-mini) -----
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: set if you want to use Azure OpenAI / GitHub Models endpoint
# instead of the default api.openai.com. Leave blank for direct OpenAI.
OPENAI_BASE_URL=
GITHUB_TOKEN=

# ----- Anthropic Claude (claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001) -----
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ----- Google Gemini (gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite) -----
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Some Google libs read GEMINI_API_KEY as a fallback — set both to be safe.
GEMINI_API_KEY=

# ----- xAI Grok (grok-4-vision, grok-3-vision, grok-3-mini-vision) -----
# Get a key: https://console.x.ai/team/default/api-keys
XAI_API_KEY=

# ----- DagsHub MLflow (for logging cloud-VLM runs alongside DINOv3 / Qwen) -----
# Get a token: https://dagshub.com/user/settings/tokens
# Already set in your ~/.zshrc; duplicated here so teammates can paste it.
DAGSHUB_USER_TOKEN=
